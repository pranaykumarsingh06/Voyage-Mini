# ==============================================================================
# VOYAGE — Environment Variables Template
# Copy this file to .env for local development:
#   cp .env.example .env
# For Vercel deployment: Configure these variables in:
#   Vercel Dashboard > Project > Settings > Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Database Configuration (Required for both Vite & Vercel)
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key

# ------------------------------------------------------------------------------
# 2. Firebase Authentication Configuration (Required for both Vite & Vercel)
# Obtain from Firebase Console > Project Settings > General > Your apps (Web)
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_web_app_id

# ------------------------------------------------------------------------------
# 3. Server-Side Privileged Secrets (Optional / Recommended for Vercel)
# Never expose these in client-side code (do NOT prefix with VITE_)
# Add to Vercel Project Settings for secure serverless API execution:
# ------------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key
